# ==============================================================================
# .env.example — Variáveis de ambiente do SecuraPy Platform
# Copie para `.env` e preencha os segredos necessários.
# ==============================================================================

# --- MongoDB (Módulo B — Eventos e Alertas) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=securapy
SECURAPY_RETENCAO_DIAS=90

# --- MySQL (Módulo B — Operadores e Permissões) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=securapy
MYSQL_PASSWORD=
MYSQL_DATABASE=securapy

# Permite fallback automático para mongomock + SQLite quando sem Docker local
SECURAPY_PERMITIR_FALLBACK=1

# --- API REST & Autenticação JWT (Módulo D) ---
SECURAPY_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
SECURAPY_JWT_EXP_MIN=60
SECURAPY_ADMIN_EMAIL=admin@cybershield.local
SECURAPY_ADMIN_SENHA=CyberShield@2026

# --- Assistente LLM (Módulo G — OpenAI / Fallback por regras) ---
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini

# --- Enriquecimento ipinfo.io (Módulo A) ---
IPINFO_TOKEN=
SECURAPY_OFFLINE=0

# --- Servidor TCP de Alertas em Tempo Real (Módulo A) ---
SECURAPY_ALERTAS_HOST=127.0.0.1
SECURAPY_ALERTAS_PORTA=9999
SECURAPY_ALERTAS_PORTA_INGESTAO=9998
